{
  "name": "obsidian-mcp-server",
  "version": "0.1.0",
  "description": "MCP server that exposes an Obsidian vault over Streamable HTTP or stdio. Works with the Perplexity web app via a custom remote connector.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "obsidian-mcp-http": "dist/index.js",
    "obsidian-mcp-stdio": "dist/stdio.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:stdio": "node dist/stdio.js",
    "dev": "tsx watch src/index.ts",
    "dev:stdio": "tsx watch src/stdio.ts",
    "setup": "tsx setup/index.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "clean": "rm -rf dist"
  },
  "keywords": ["mcp", "obsidian", "perplexity", "streamable-http"],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "express": "^4.21.2",
    "gray-matter": "^4.0.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18"
  }
}
