# HTTP server
PORT=3000
HOST=0.0.0.0

# MCP identity
MCP_SERVER_NAME=mcp-streamable-http-template
MCP_SERVER_VERSION=0.1.0

# Path where the MCP endpoint is mounted
MCP_PATH=/mcp

# Stateless mode spawns a fresh server per request (recommended for serverless
# and simple deployments like Perplexity). Set to "false" to keep sessions
# across requests and enable server->client notifications over GET SSE.
MCP_STATELESS=true

# When true, responses that don't need streaming are returned as plain JSON
# instead of SSE. Leave "false" unless your client has trouble with SSE.
MCP_ENABLE_JSON_RESPONSE=false

# CORS: comma-separated list of allowed origins, or "*"
ALLOWED_ORIGINS=*

# Optional: require Authorization: Bearer <token> on all /mcp requests
MCP_AUTH_TOKEN=

# Optional: fixed-window per-IP rate limit on /mcp. Leave RATE_LIMIT_MAX empty
# to disable. Window defaults to 60000 ms if unset.
RATE_LIMIT_MAX=
RATE_LIMIT_WINDOW_MS=60000

# If behind a proxy/load balancer that sets X-Forwarded-For, set this to true
# so the rate limiter and logs see the real client IP.
TRUST_PROXY=false
